# ---------- 依赖 ----------
node_modules/

# ---------- 业务数据库与备份（最重要） ----------
# data/ 里是全部真实业务数据：客户资料、账目、成本。一旦误提交就是把这些
# 信息上传到公开仓库，无法撤回（git 历史会永久保留）。
data/
*.db
*.db-wal
*.db-shm
*.db-journal
backups/

# ---------- 会话密钥 ----------
# 拿到这个文件即可伪造任意用户的登录态，等价于泄露全部权限。
.session_secret

# ---------- 音频素材 ----------
# 只排除音频本身（本项目 mp3/ 约 79MB，且多为第三方版权音乐），
# 目录里的「请把文件放到这里.txt」说明要进仓库——README 承诺了目录会自带说明，
# 且服务启动时也会自动创建这两个目录，新克隆的仓库不至于摸不着头脑。
# 注意必须写 mp3/* 而不是 mp3/：一旦整个目录被忽略，! 规则就无法再把里面的文件捞回来。
mp3/*
!mp3/*.txt
Broadcast/*
!Broadcast/*.txt

# ---------- 日志与临时文件 ----------
*.log
tmp/
.tmp/
