# ---------- 依赖 ----------
node_modules/

# ---------- 业务数据库与备份（最重要） ----------
# data/ 里是全部真实业务数据：客户资料、账目、成本。一旦误提交就是把这些
# 信息上传到公开仓库，无法撤回（git 历史会永久保留）。
data/
*.db
*.db-wal
*.db-shm
*.db-journal
backups/

# ---------- 会话密钥 ----------
# 拿到这个文件即可伪造任意用户的登录态，等价于泄露全部权限。
.session_secret

# ---------- 音频素材 ----------
# 体积较大（本项目 mp3/ 约 79MB），通常不进代码库。
# 如果希望音乐/广播随代码一起版本管理，删掉下面两行即可。
mp3/
Broadcast/

# ---------- 日志与临时文件 ----------
*.log
tmp/
.tmp/
